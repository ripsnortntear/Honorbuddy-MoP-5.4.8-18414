  <SubRoutine SubRoutineName="- Subroutines -">
    <SubRoutine SubRoutineName="ToCrocodile">
      <CustomAction Code="Log(Colors.Green,&quot;Moving to: &quot;,Colors.Red,&quot;Crocodile farmspot&quot;);" />
      <FlyToAction Dismount="False" Location="-2367.38, 604.78, 0.22858" />
    </SubRoutine>
    <SubRoutine SubRoutineName="ToTurtle">
      <CustomAction Code="Log(Colors.Green,&quot;Moving to: &quot;,Colors.Red,&quot;Turtle farmspot&quot;);" />
      <FlyToAction Dismount="False" Location="-1198.6, -339.17, 0.8636683" />
    </SubRoutine>
    <SubRoutine SubRoutineName="ToCrab">
      <CustomAction Code="Log(Colors.Green,&quot;Moving to: &quot;,Colors.Red,&quot;Crab farmspot&quot;);" />
      <FlyToAction Dismount="True" Location="-701.8103, 4181.907, 0.2620023" />
    </SubRoutine>
    <SubRoutine SubRoutineName="ToTiger">
      <CustomAction Code="Log(Colors.Green,&quot;Moving to: &quot;,Colors.Red,&quot;Tiger farmspot&quot;);" />
