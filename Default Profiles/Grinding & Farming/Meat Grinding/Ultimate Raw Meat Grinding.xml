<?xml version="1.0" encoding="utf-8"?>
<Professionbuddy>
  <CustomAction Code="CharacterSettings.Instance.LootMobs = true;" />
  <CustomAction Code="Lua.DoString(&quot;SetCVar(\&quot;AutoLootDefault\&quot;, 1)&quot;);" />
  <Declaration Code="int crocodile;" />
