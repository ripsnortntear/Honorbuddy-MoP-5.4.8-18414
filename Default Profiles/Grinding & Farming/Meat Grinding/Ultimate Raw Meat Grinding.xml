  <CustomAction Code="crocodile = (Int16)Settings[&quot;Stacks of Crocodile Meat&quot;];" />
  <Settings DefaultValue="5" Type="Int16" Name="Stacks of Turtle Meat" Summary="Amount of stacks before going to mailbox." Category="How many stacks to farm before we turn them in" Global="False" Hidden="False" />
