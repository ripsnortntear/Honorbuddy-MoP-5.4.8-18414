  <CustomAction Code="turtle = (Int16)Settings[&quot;Stacks of Turtle Meat&quot;];" />
  <Settings DefaultValue="5" Type="Int16" Name="Stacks of Crab Meat" Summary="Amount of stacks before going to mailbox." Category="How many stacks to farm before we turn them in" Global="False" Hidden="False" />
