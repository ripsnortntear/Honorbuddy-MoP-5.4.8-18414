<HBProfile xsi:noNamespaceSchemaLocation="../Schemas/QuestProfileSchema.xsd"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <Name>[Test] Orgrimmar Elevator - Valley of Strength to Flight Master</Name>

    <MinLevel>1</MinLevel>
    <MaxLevel>1001</MaxLevel>

    <MinDurability>0.1</MinDurability>
    <MinFreeBagSlots>0</MinFreeBagSlots>

    <QuestOrder IgnoreCheckpoints="true">
        <!-- Disable automatic flight path learning during this test so the Taxi window does not open -->
        <DisableBehavior Name="FlightPath" />
        <CustomBehavior File="ForcedDismount" />

        <CustomBehavior File="Message" Text="======================================================" LogColor="CornflowerBlue" />
        <CustomBehavior File="Message" Text="[Elevator Test] Starting Orgrimmar Elevator Verification Profile" LogColor="CornflowerBlue" />
        <CustomBehavior File="Message" Text="======================================================" LogColor="CornflowerBlue" />

        <!-- Round 1: Move to Valley of Strength Center -->
        <CustomBehavior File="Message" Text="[Elevator Test] Round 1: Navigating to Valley of Strength Center..." LogColor="Yellow" />
        <MoveTo DestName="Valley of Strength Center" X="1573.266" Y="-4439.158" Z="16.05683" />
        <CustomBehavior File="WaitTimer" WaitTime="2000" />

        <!-- Round 1: UP via Elevator to Upper Flight Deck -->
        <CustomBehavior File="Message" Text="[Elevator Test] Round 1: Moving UP to Flight Deck via Central Elevator..." LogColor="Yellow" />
        <MoveTo DestName="Upper Flight Deck" X="1775.355" Y="-4364.016" Z="102.5204" />
        <CustomBehavior File="Message" Text="[Elevator Test] Reached upper flight deck via elevator (Round 1)." LogColor="Green" />
        <CustomBehavior File="WaitTimer" WaitTime="3000" />

        <!-- Round 1: DOWN via Elevator to Valley of Strength Center -->
        <CustomBehavior File="Message" Text="[Elevator Test] Round 1: Moving DOWN to Valley of Strength via Central Elevator..." LogColor="Yellow" />
        <MoveTo DestName="Valley of Strength Center" X="1573.266" Y="-4439.158" Z="16.05683" />
        <CustomBehavior File="Message" Text="[Elevator Test] Reached Valley of Strength via elevator (Round 1)." LogColor="Green" />
        <CustomBehavior File="WaitTimer" WaitTime="3000" />

        <!-- Round 2: UP via Elevator to Upper Flight Deck -->
        <CustomBehavior File="Message" Text="[Elevator Test] Round 2: Moving UP to Flight Deck via Central Elevator..." LogColor="Yellow" />
        <MoveTo DestName="Upper Flight Deck" X="1775.355" Y="-4364.016" Z="102.5204" />
        <CustomBehavior File="Message" Text="[Elevator Test] Reached upper flight deck via elevator (Round 2)." LogColor="Green" />
        <CustomBehavior File="WaitTimer" WaitTime="3000" />

        <!-- Round 2: DOWN via Elevator to Valley of Strength Center -->
        <CustomBehavior File="Message" Text="[Elevator Test] Round 2: Moving DOWN to Valley of Strength via Central Elevator..." LogColor="Yellow" />
        <MoveTo DestName="Valley of Strength Center" X="1573.266" Y="-4439.158" Z="16.05683" />
        <CustomBehavior File="Message" Text="[Elevator Test] Reached Valley of Strength via elevator (Round 2)." LogColor="Green" />
        <CustomBehavior File="WaitTimer" WaitTime="2000" />

        <!-- Re-enable FlightPath behavior -->
        <EnableBehavior Name="FlightPath" />

        <CustomBehavior File="Message" Text="======================================================" LogColor="CornflowerBlue" />
        <CustomBehavior File="Message" Text="[Elevator Test] All Orgrimmar Elevator tests completed successfully!" LogColor="Green" />
        <CustomBehavior File="Message" Text="======================================================" LogColor="CornflowerBlue" />
    </QuestOrder>
</HBProfile>
