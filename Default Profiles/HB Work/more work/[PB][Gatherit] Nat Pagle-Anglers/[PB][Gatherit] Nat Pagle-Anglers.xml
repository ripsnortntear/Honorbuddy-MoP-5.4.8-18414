<?xml version="1.0" encoding="utf-8"?>
<Professionbuddy>
  <Declaration Code="uint CurrentItem = 0;" />
  <SubRoutine SubRoutineName="Decide Action">
    <!--First item-->
    <If Condition="InbagCount(86542) ==  0 &amp;&amp; InbagCount(86544) == 0 &amp;&amp; InbagCount(86545) == 0" IgnoreCanRun="True">
      <!--Set the current item to check for to itemID of the first item-->
      <CustomAction Code="CurrentItem = 86542;" />
      <!--Fly to fish spot for Flying Tiger Gourami-->
      <FlyToAction Dismount="True" Location="1692.05, 312.6114, 479.1812" />
      <MoveToAction Location="1701.241, 295.5167, 475.5357" MoveType="Location" Pathing="ClickToMove" Entry="0" />
      <ChangeBotAction BotName="AutoAngler" />
      <!--Load the profile-->
      <LoadProfileAction ProfileType="Honorbuddy" Path="Combat.xml" />
    </If>
    <!--Second item-->
    <If Condition="InbagCount(86542) ==  1 &amp;&amp; InbagCount(86544) == 0 &amp;&amp; InbagCount(86545) == 0" IgnoreCanRun="True">
      <!--Set the current item to check for to itemID of the first item-->
      <CustomAction Code="CurrentItem = 86544;" />
      <!--Fly to fish spot for Spinefish Alpha-->
      <FlyToAction Dismount="True" Location="1878.289, 203.6797, 482.0601" />
      <MoveToAction Location="1880.448, 220.0223, 476.8923" MoveType="Location" Pathing="ClickToMove" Entry="0" />
      <ChangeBotAction BotName="AutoAngler" />
      <!--Load the profile-->
      <LoadProfileAction ProfileType="Honorbuddy" Path="Combat.xml" />
    </If>
    <!--Third item-->
    <If Condition="InbagCount(86542) ==  1 &amp;&amp; InbagCount(86544) == 1 &amp;&amp; InbagCount(86545) == 0" IgnoreCanRun="True">
      <!--Set the current item to check for to itemID of the first item-->
      <CustomAction Code="CurrentItem = 86545;" />
      <!--Fly to fish spot for Mimic Octopus-->
      <FlyToAction Dismount="True" Location="-1476.828, -248.05, 5.066746" />
      <MoveToAction Location="-1463.749, -256.5433, 0.3329802" MoveType="Location" Pathing="ClickToMove" Entry="0" />
      <ChangeBotAction BotName="AutoAngler" />
      <!--Load the profile-->
      <LoadProfileAction ProfileType="Honorbuddy" Path="Combat.xml" />
    </If>
    <!--Done-->
    <If Condition="InbagCount(86542) ==  1 &amp;&amp; InbagCount(86544) == 1 &amp;&amp; InbagCount(86545) == 1" IgnoreCanRun="True">
      <!--Set current item to check for 0 so this won't be looped while you have all 3 items-->
      <CustomAction Code="CurrentItem = 0;" />
      <!--Fly to quest guy (if not handled in quest profile)-->
      <FlyToAction Dismount="True" Location="-1463.414, -254.1569, 0.3319396" />
      <ChangeBotAction BotName="Questing" />
      <!--Load the profile-->
      <LoadProfileAction ProfileType="Honorbuddy" Path="[Gatherit] 3 Rare Fish.xml" />
    </If>
  </SubRoutine>
  <CallSubRoutine SubRoutineName="Decide Action" />
  <While Condition="InbagCount(CurrentItem) &gt; 0" IgnoreCanRun="True">
    <CallSubRoutine SubRoutineName="Decide Action" />
  </While>
</Professionbuddy>