  <SubRoutine SubRoutineName="PortalToTown">
    <If Condition="Me.IsAlliance" IgnoreCanRun="True">
      <While Condition="!(Me.MapId == 0 || Me.MapId == 1 )" IgnoreCanRun="False">
        <If Condition="!(Me.ZoneId == 6142)" IgnoreCanRun="True">
          <FlyToAction Dismount="False" Location="859.4655, 281.1173, 503.2266" />
        </If>
        <MoveToAction Location="827.9862, 177.2762, 519.9348" MoveType="Location" Pathing="Navigator" Entry="0" />
        <InteractionAction InteractType="GameObject" Entry="215119" InteractDelay="0" GameObjectType="WorldObject" SpellFocus="Anvil" />
        <WaitAction Condition="false" Timeout="3000" />
      </While>
    </If>
    <If Condition="Me.IsHorde" IgnoreCanRun="False">
      <While Condition="!(Me.MapId == 0 || Me.MapId == 1 )" IgnoreCanRun="False">
        <If Condition="!(Me.ZoneId == 6141)" IgnoreCanRun="True">
          <FlyToAction Dismount="False" Location="1629.769, 924.1738, 471.1844" />
        </If>
        <MoveToAction Location="1735.073, 873.5676, 487.4114" MoveType="Location" Pathing="Navigator" Entry="0" />
        <InteractionAction InteractType="GameObject" Entry="215127" InteractDelay="0" GameObjectType="WorldObject" SpellFocus="Anvil" />
        <WaitAction Condition="false" Timeout="3000" />
      </While>
    </If>
  </SubRoutine>
  <SubRoutine SubRoutineName="PortalToPandaria">
    <While Condition="Me.MapId == 0 &amp;&amp; Me.IsAlliance" IgnoreCanRun="False">
      <FlyToAction Dismount="True" Location="-8199.262, 531.4355, 117.326" />
      <InteractionAction InteractType="GameObject" Entry="215457" InteractDelay="0" GameObjectType="WorldObject" SpellFocus="Anvil" />
      <WaitAction Condition="false" Timeout="3000" />
    </While>
    <While Condition="Me.MapId == 1 &amp;&amp; Me.IsHorde" IgnoreCanRun="False">
      <FlyToAction Dismount="True" Location="2014.819, -4700.274, 28.62439" />
      <InteractionAction InteractType="GameObject" Entry="215424" InteractDelay="0" GameObjectType="WorldObject" SpellFocus="Anvil" />
      <WaitAction Condition="false" Timeout="3000" />
    </While>
  </SubRoutine>
  <SubRoutine SubRoutineName="MoveToMarket">
    <If Condition="Me.IsAlliance" IgnoreCanRun="True">
      <FlyToAction Dismount="True" Location="-8378.115, 640.2366, 94.99358" />
    </If>
    <If Condition="Me.IsHorde" IgnoreCanRun="True">
      <FlyToAction Dismount="True" Location="1969.626, -4680.478, 31.38253" />
    </If>
  </SubRoutine>
  <SubRoutine SubRoutineName="MoveToMailbox">
    <If Condition="Me.IsAlliance" IgnoreCanRun="True">
      <MoveToAction Location="863.3191, 284.0312, 503.6776" MoveType="Location" Pathing="Navigator" Entry="0" />
    </If>
    <If Condition="Me.IsHorde" IgnoreCanRun="True">
      <MoveToAction Location="1629.769, 924.1738, 471.1844" MoveType="Location" Pathing="Navigator" Entry="0" />
    </If>
  </SubRoutine>
  <While Condition="true" IgnoreCanRun="True">
    <While Condition="(Me.MapId == 0 || Me.MapId == 1 )" IgnoreCanRun="True">
      <ChangeBotAction BotName="Combat Bot" />
      <If Condition="DoTownRun" IgnoreCanRun="True">
        <CallSubRoutine SubRoutineName="MoveToMarket" />
        <CallSubRoutine SubRoutineName="TownRun" />
      </If>
      <CallSubRoutine SubRoutineName="PortalToPandaria" />
    </While>
    <While Condition="(Me.FreeBagSlots &gt; 5 || OnlyGather) &amp;&amp; !(Me.MapId == 0 || Me.MapId == 1 )" IgnoreCanRun="False">
      <While Condition="(InbagCount (88496)) &gt;= 1" IgnoreCanRun="True">
        <CustomAction Code="Lua.DoString(&quot;UseItemByName(88496)&quot;); Thread.Sleep(2000);" />
      </While>
      <If Condition="(InbagCount (88496)) &gt;= 1" IgnoreCanRun="True">
        <CustomAction Code="Lua.DoString(&quot;UseItemByName(88496)&quot;); Thread.Sleep(2000);" />
      </If>
      <ChangeBotAction BotName="AutoAngler" />
      <LoadProfileAction ProfileType="Honorbuddy" Path="HBProfiles\[AA][N] Mega Fishing Profile 2.0 -Pandaria - By Lbniese.xml" />
    </While>
    <While Condition="!(Me.FreeBagSlots &gt; 5) &amp;&amp; !(Me.MapId == 0 || Me.MapId == 1 )" IgnoreCanRun="True">
      <ChangeBotAction BotName="Combat Bot" />
      <If Condition="DoTownRun" IgnoreCanRun="True">
        <CallSubRoutine SubRoutineName="PortalToTown" />
      </If>
      <If Condition="!DoTownRun" IgnoreCanRun="True">
        <CallSubRoutine SubRoutineName="MoveToMailbox" />
        <MailItemAction Category="TradeGoods" SubCategoryType="WoWItemTradeGoodsClass" SubCategory="None" Mail="All" UseCategory="True" ItemID="" Amount="0" AutoFindMailBox="True" Location="0, 0, 0" />
      </If>
    </While>
    <While Condition="(InbagCount (88496)) &gt;= 1" IgnoreCanRun="True">
      <CustomAction Code="Lua.DoString(&quot;UseItemByName(88496)&quot;); Thread.Sleep(2000);" />
    </While>
    <If Condition="(InbagCount (88496)) &gt;= 1" IgnoreCanRun="True">
      <CustomAction Code="Lua.DoString(&quot;UseItemByName(88496)&quot;); Thread.Sleep(2000);" />
    </If>
  </While>
</Professionbuddy>