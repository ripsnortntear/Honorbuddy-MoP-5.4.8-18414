    <SellItemOnAhAction Category="TradeGoods" SubCategoryType="WoWItemTradeGoodsClass" SubCategory="None" UseCategory="False" RunTime="_12_Hours" AmountType="Amount" ItemID="89639" MinBuyout="1g10s0c" MaxBuyout="10g0s0c" StackSize="20" IgnoreStackSizeBelow="1" Amount="DesecratedStacks" BidPrecent="95" UndercutPrecent="0.1" AutoFindAh="True" PostIfBelowMinBuyout="True" Location="0, 0, 0" />
    <SellItemOnAhAction Category="TradeGoods" SubCategoryType="WoWItemTradeGoodsClass" SubCategory="None" UseCategory="False" RunTime="_12_Hours" AmountType="Amount" ItemID="79011" MinBuyout="1g10s0c" MaxBuyout="10g0s0c" StackSize="20" IgnoreStackSizeBelow="1" Amount="FoolStacks" BidPrecent="95" UndercutPrecent="0.1" AutoFindAh="True" PostIfBelowMinBuyout="True" Location="0, 0, 0" />
    <SellItemOnAhAction Category="TradeGoods" SubCategoryType="WoWItemTradeGoodsClass" SubCategory="None" UseCategory="False" RunTime="_12_Hours" AmountType="Amount" ItemID="72238" MinBuyout="1g10s0c" MaxBuyout="300g0s0c" StackSize="1" IgnoreStackSizeBelow="1" Amount="GoldenLotusStacks" BidPrecent="95" UndercutPrecent="0.1" AutoFindAh="True" PostIfBelowMinBuyout="True" Location="0, 0, 0" />
    <SellItemOnAhAction Category="TradeGoods" SubCategoryType="WoWItemTradeGoodsClass" SubCategory="None" UseCategory="False" RunTime="_12_Hours" AmountType="Amount" ItemID="72093" MinBuyout="1g10s0c" MaxBuyout="10g0s0c" StackSize="20" IgnoreStackSizeBelow="1" Amount="KypariteStacks" BidPrecent="95" UndercutPrecent="0.1" AutoFindAh="True" PostIfBelowMinBuyout="True" Location="0, 0, 0" />
    <SellItemOnAhAction Category="TradeGoods" SubCategoryType="WoWItemTradeGoodsClass" SubCategory="None" UseCategory="False" RunTime="_12_Hours" AmountType="Amount" ItemID="72092" MinBuyout="1g10s0c" MaxBuyout="10g0s0c" StackSize="20" IgnoreStackSizeBelow="1" Amount="GhostIronStacks" BidPrecent="95" UndercutPrecent="0.1" AutoFindAh="True" PostIfBelowMinBuyout="True" Location="0, 0, 0" />
    <SellItemOnAhAction Category="TradeGoods" SubCategoryType="WoWItemTradeGoodsClass" SubCategory="None" UseCategory="False" RunTime="_12_Hours" AmountType="Amount" ItemID="72094" MinBuyout="1g10s0c" MaxBuyout="20g0s0c" StackSize="20" IgnoreStackSizeBelow="1" Amount="BlackTrilliumStacks" BidPrecent="95" UndercutPrecent="0.1" AutoFindAh="True" PostIfBelowMinBuyout="True" Location="0, 0, 0" />
    <SellItemOnAhAction Category="TradeGoods" SubCategoryType="WoWItemTradeGoodsClass" SubCategory="None" UseCategory="False" RunTime="_12_Hours" AmountType="Amount" ItemID="72103" MinBuyout="1g10s0c" MaxBuyout="20g0s0c" StackSize="20" IgnoreStackSizeBelow="1" Amount="WhiteTrilliumStacks" BidPrecent="95" UndercutPrecent="0.1" AutoFindAh="True" PostIfBelowMinBuyout="True" Location="0, 0, 0" />
    <SellItemOnAhAction Category="TradeGoods" SubCategoryType="WoWItemTradeGoodsClass" SubCategory="None" UseCategory="False" RunTime="_12_Hours" AmountType="Amount" ItemID="72095" MinBuyout="1g10s0c" MaxBuyout="100g0s0c" StackSize="1" IgnoreStackSizeBelow="1" Amount="TrilliumBarStacks" BidPrecent="95" UndercutPrecent="0.1" AutoFindAh="True" PostIfBelowMinBuyout="True" Location="0, 0, 0" />
    <SellItemOnAhAction Category="TradeGoods" SubCategoryType="WoWItemTradeGoodsClass" SubCategory="None" UseCategory="False" RunTime="_12_Hours" AmountType="Amount" ItemID="72096" MinBuyout="1g10s0c" MaxBuyout="20g0s0c" StackSize="20" IgnoreStackSizeBelow="1" Amount="GhostBarStacks" BidPrecent="95" UndercutPrecent="0.1" AutoFindAh="True" PostIfBelowMinBuyout="True" Location="0, 0, 0" />
    <GetMailAction GetMailType="AllItems" ItemID="" CheckNewMail="True" MinFreeBagSlots="0" AutoFindMailBox="True" Location="0, 0, 0" />
    <If Condition="(bool)Settings[&quot;Deposit in Gbank instead of Bank&quot;]" IgnoreCanRun="True">
      <PutItemInBankAction Category="TradeGoods" SubCategoryType="WoWItemTradeGoodsClass" SubCategory="None" Deposit="All" UseCategory="True" Bank="Guild" ItemID="" GuildTab="0" NpcEntry="0" Amount="0" AutoFindBank="True" Location="0, 0, 0" />
    </If>
    <PutItemInBankAction Category="TradeGoods" SubCategoryType="WoWItemTradeGoodsClass" SubCategory="None" Deposit="All" UseCategory="True" Bank="Personal" ItemID="" GuildTab="0" NpcEntry="0" Amount="0" AutoFindBank="True" Location="0, 0, 0" />
  </SubRoutine>
  <SubRoutine SubRoutineName="PortalToTown">
    <If Condition="Me.IsAlliance" IgnoreCanRun="True">
      <While Condition="!(Me.MapId == 0 || Me.MapId == 1 )" IgnoreCanRun="False">
        <If Condition="!(Me.ZoneId == 6142)" IgnoreCanRun="True">
          <FlyToAction Dismount="False" Location="859.4655, 281.1173, 503.2266" />
        </If>
        <If Condition="!((bool)Settings[&quot;Use Hearthstone&quot;])" IgnoreCanRun="True">
          <MoveToAction Location="827.9862, 177.2762, 519.9348" MoveType="Location" Pathing="Navigator" Entry="0" />
          <InteractionAction InteractType="GameObject" Entry="215119" InteractDelay="0" GameObjectType="WorldObject" SpellFocus="Anvil" />
          <WaitAction Condition="false" Timeout="3000" />
        </If>
        <If Condition="(bool)Settings[&quot;Use Hearthstone&quot;]" IgnoreCanRun="True">
          <FlyToAction Dismount="True" Location="859.4655, 281.1173, 503.2266" />
          <CustomAction Code="Lua.DoString(&quot;UseItemByName(6948)&quot;);" />
        </If>
      </While>
    </If>
    <If Condition="Me.IsHorde" IgnoreCanRun="False">
      <While Condition="!(Me.MapId == 0 || Me.MapId == 1 )" IgnoreCanRun="False">
        <If Condition="!(Me.ZoneId == 6141)" IgnoreCanRun="True">
          <FlyToAction Dismount="False" Location="1629.769, 924.1738, 471.1844" />
        </If>
        <If Condition="!((bool)Settings[&quot;Use Hearthstone&quot;])" IgnoreCanRun="True">
          <MoveToAction Location="1735.073, 873.5676, 487.4114" MoveType="Location" Pathing="Navigator" Entry="0" />
          <InteractionAction InteractType="GameObject" Entry="215127" InteractDelay="0" GameObjectType="WorldObject" SpellFocus="Anvil" />
          <WaitAction Condition="false" Timeout="3000" />
        </If>
        <If Condition="(bool)Settings[&quot;Use Hearthstone&quot;]" IgnoreCanRun="True">
          <FlyToAction Dismount="True" Location="1629.769, 924.1738, 471.1844" />
          <CustomAction Code="Lua.DoString(&quot;UseItemByName(6948)&quot;);" />
        </If>
      </While>
    </If>
  </SubRoutine>
  <SubRoutine SubRoutineName="PortalToPandaria">
    <While Condition="Me.MapId == 0 &amp;&amp; Me.IsAlliance" IgnoreCanRun="False">
      <FlyToAction Dismount="True" Location="-8199.262, 531.4355, 117.326" />
      <InteractionAction InteractType="GameObject" Entry="215457" InteractDelay="0" GameObjectType="WorldObject" SpellFocus="Anvil" />
      <WaitAction Condition="false" Timeout="3000" />
    </While>
    <While Condition="Me.MapId == 1 &amp;&amp; Me.IsHorde" IgnoreCanRun="False">
      <FlyToAction Dismount="True" Location="2014.819, -4700.274, 28.62439" />
      <InteractionAction InteractType="GameObject" Entry="215424" InteractDelay="0" GameObjectType="WorldObject" SpellFocus="Anvil" />
      <WaitAction Condition="false" Timeout="3000" />
    </While>
  </SubRoutine>
  <SubRoutine SubRoutineName="MoveToMarket">
    <If Condition="Me.IsAlliance" IgnoreCanRun="True">
      <FlyToAction Dismount="True" Location="-8378.115, 640.2366, 94.99358" />
    </If>
    <If Condition="Me.IsHorde" IgnoreCanRun="True">
      <FlyToAction Dismount="True" Location="1969.626, -4680.478, 31.38253" />
    </If>
  </SubRoutine>
  <SubRoutine SubRoutineName="MoveToForge">
    <If Condition="Me.IsAlliance &amp;&amp; !(Me.MapId == 0 || Me.MapId == 1 )" IgnoreCanRun="True">
      <FlyToAction Dismount="False" Location="859.4655, 281.1173, 503.2266" />
      <MoveToAction Location="818.3885, 194.0553, 503.4206" MoveType="Location" Pathing="Navigator" Entry="0" />
    </If>
    <If Condition="Me.IsAlliance &amp;&amp; (Me.MapId == 0 || Me.MapId == 1 )" IgnoreCanRun="True">
      <MoveToAction Location="-8424.288, 628.4113, 95.74207" MoveType="Location" Pathing="Navigator" Entry="0" />
    </If>
    <If Condition="Me.IsHorde &amp;&amp; !(Me.MapId == 0 || Me.MapId == 1 )" IgnoreCanRun="True">
      <FlyToAction Dismount="False" Location="1629.769, 924.1738, 471.1844" />
      <MoveToAction Location="1705, 987.2623, 470.9242" MoveType="Location" Pathing="Navigator" Entry="0" />
    </If>
    <If Condition="Me.IsHorde &amp;&amp; (Me.MapId == 0 || Me.MapId == 1 )" IgnoreCanRun="True">
      <MoveToAction Location="2055.922, -4825.065, 27.47281" MoveType="Location" Pathing="Navigator" Entry="0" />
    </If>
  </SubRoutine>
  <SubRoutine SubRoutineName="MoveToMailbox">
    <If Condition="Me.IsAlliance" IgnoreCanRun="True">
      <MoveToAction Location="863.3191, 284.0312, 503.6776" MoveType="Location" Pathing="Navigator" Entry="0" />
    </If>
    <If Condition="Me.IsHorde" IgnoreCanRun="True">
      <MoveToAction Location="1629.769, 924.1738, 471.1844" MoveType="Location" Pathing="Navigator" Entry="0" />
    </If>
  </SubRoutine>
  <SubRoutine SubRoutineName="Smelt">
    <CallSubRoutine SubRoutineName="MoveToForge" />
    <CustomAction Code="SmeltCounts = InbagCount(72092) * SmeltPercent / 200;" />
    <CastSpellAction RepeatType="Specific" Repeat="SmeltCounts" Entry="102165" CastOnItem="False" ItemType="Chest" ItemId="0" />
    <While Condition="HasMats(102167)" IgnoreCanRun="True">
      <CastSpellAction RepeatType="Specific" Repeat="1" Entry="102167" CastOnItem="False" ItemType="Chest" ItemId="0" />
    </While>
  </SubRoutine>
  <While Condition="true" IgnoreCanRun="True">
    <While Condition="(Me.MapId == 0 || Me.MapId == 1 )" IgnoreCanRun="True">
      <ChangeBotAction BotName="Combat Bot" />
      <If Condition="DoTownRun" IgnoreCanRun="True">
        <CallSubRoutine SubRoutineName="MoveToMarket" />
        <CallSubRoutine SubRoutineName="TownRun" />
      </If>
      <CallSubRoutine SubRoutineName="PortalToPandaria" />
    </While>
    <While Condition="(Me.FreeBagSlots &gt; 5 || OnlyGather) &amp;&amp; !(Me.MapId == 0 || Me.MapId == 1 )" IgnoreCanRun="False">
      <ChangeBotAction BotName="Gatherbuddy2" />
      <LoadProfileAction ProfileType="Honorbuddy" Path="[Gatherit]Custom Multi-Zone.xml" />
    </While>
    <While Condition="!(Me.FreeBagSlots &gt; 5) &amp;&amp; !(Me.MapId == 0 || Me.MapId == 1 )" IgnoreCanRun="True">
      <ChangeBotAction BotName="Combat Bot" />
      <If Condition="DoTownRun" IgnoreCanRun="True">
        <CallSubRoutine SubRoutineName="PortalToTown" />
      </If>
      <If Condition="!DoTownRun &amp;&amp; Smelt" IgnoreCanRun="True">
        <CallSubRoutine SubRoutineName="Smelt" />
        <CallSubRoutine SubRoutineName="MoveToMailbox" />
        <MailItemAction Category="TradeGoods" SubCategoryType="WoWItemTradeGoodsClass" SubCategory="None" Mail="All" UseCategory="True" ItemID="" Amount="0" AutoFindMailBox="True" Location="0, 0, 0" />
      </If>
    </While>
  </While>
</Professionbuddy>