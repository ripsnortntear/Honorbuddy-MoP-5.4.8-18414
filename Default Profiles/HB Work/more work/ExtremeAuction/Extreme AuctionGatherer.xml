<?xml version="1.0" encoding="utf-8"?>
<Professionbuddy>
  <SubRoutine SubRoutineName="Declarations">
    <Declaration Code="int SmeltCounts, SmeltPercent, GreenTeaStacks, SnowLilyStacks, RainPoppyStacks, SilkweedStacks, DesecratedStacks, FoolStacks, GhostIronStacks, GoldenLotusStacks, KypariteStacks, WhiteTrilliumStacks, BlackTrilliumStacks, GhostBarStacks, TrilliumBarStacks;" />
    <Declaration Code="bool OnlyGather = false;" />
    <Declaration Code="bool InPandaria, DoTownRun, Smelt;" />
  </SubRoutine>
  <SubRoutine SubRoutineName="Settings">
    <!--Amount of Stacks-->
    <Settings DefaultValue="100" Type="Int16" Name="Green Tea Leaf" Summary="The bot will not put more than this amount of stacks of each item on AH." Category="Number of Stacks posted on AH  - Herbs" Global="False" Hidden="False" />
    <Settings DefaultValue="100" Type="Int16" Name="Snow Lily" Summary="The bot will not put more than this amount of stacks of each item on AH." Category="Number of Stacks posted on AH  - Herbs" Global="False" Hidden="False" />
    <Settings DefaultValue="100" Type="Int16" Name="Silkweed" Summary="The bot will not put more than this amount of stacks of each item on AH." Category="Number of Stacks posted on AH  - Herbs" Global="False" Hidden="False" />
    <Settings DefaultValue="100" Type="Int16" Name="Desecrated Herb" Summary="The bot will not put more than this amount of stacks of each item on AH." Category="Number of Stacks posted on AH  - Herbs" Global="False" Hidden="False" />
    <Settings DefaultValue="100" Type="Int16" Name="Rain Poppy" Summary="The bot will not put more than this amount of stacks of each item on AH." Category="Number of Stacks posted on AH  - Herbs" Global="False" Hidden="False" />
    <Settings DefaultValue="100" Type="Int16" Name="Fool's Cap" Summary="The bot will not put more than this amount of stacks of each item on AH." Category="Number of Stacks posted on AH  - Herbs" Global="False" Hidden="False" />
    <Settings DefaultValue="100" Type="Int16" Name="Golden Lotus ( Singles 1x )" Summary="The bot will not put more than this amount of stacks of each item on AH." Category="Number of Stacks posted on AH  - Herbs" Global="False" Hidden="False" />
    <Settings DefaultValue="100" Type="Int16" Name="Ghost Iron Ore" Summary="The bot will not put more than this amount of stacks of each item on AH." Category="Number of Stacks posted on AH - Ores" Global="False" Hidden="False" />
    <Settings DefaultValue="100" Type="Int16" Name="Kyparite" Summary="The bot will not put more than this amount of stacks of each item on AH." Category="Number of Stacks posted on AH - Ores" Global="False" Hidden="False" />
    <Settings DefaultValue="100" Type="Int16" Name="Black Trillium Ore" Summary="The bot will not put more than this amount of stacks of each item on AH." Category="Number of Stacks posted on AH - Ores" Global="False" Hidden="False" />
    <Settings DefaultValue="100" Type="Int16" Name="White Trillium Ore" Summary="The bot will not put more than this amount of stacks of each item on AH." Category="Number of Stacks posted on AH - Ores" Global="False" Hidden="False" />
    <Settings DefaultValue="100" Type="Int16" Name="Trillium Bar ( Singles 1x )" Summary="The bot will not put more than this amount of stacks of each item on AH." Category="Number of Stacks posted on AH - Bars" Global="False" Hidden="False" />
    <Settings DefaultValue="100" Type="Int16" Name="Ghost Iron Bar" Summary="The bot will not put more than this amount of stacks of each item on AH." Category="Number of Stacks posted on AH - Bars" Global="False" Hidden="False" />
    <!--Misc-->
    <Settings DefaultValue="true" Type="Boolean" Name="Do Town Run" Summary="If set to True , when bags fill up the bot will take portal to SW / Orgrimmar and post on AH and Deposit in Bank / Gbank , and then take portal back to Pandaria and continue farming." Category="Misc" Global="False" Hidden="False" />
    <Settings DefaultValue="false" Type="Boolean" Name="Use Hearthstone" Summary="If set to True , when bags fill up the bot will take portal to SW / Orgrimmar and post on AH and Deposit in Bank / Gbank , and then take portal back to Pandaria and continue farming." Category="Misc" Global="False" Hidden="False" />
    <Settings DefaultValue="false" Type="Boolean" Name="Deposit in Gbank instead of Bank" Summary="Deposits the remaining Herbs and Ores to the Bank / GBank after posting on AH.  If this Option is False , then the bot will Deposit in Personal Bank , and if Personal Bank is full , it will mail the rest. If this option is True , then the priority will be Gbank -&gt; Personal Bank -&gt; Mail" Category="Misc" Global="False" Hidden="False" />
    <!--Smelt Ores-->
    <Settings DefaultValue="100" Type="Int16" Name="Percentage % of Ores to Smelt" Summary="" Category="Smelting" Global="False" Hidden="False" />
    <Settings DefaultValue="false" Type="Boolean" Name="Smelt Ores" Summary="If set True , the bot will Smelt the ores. You can pick what percentage of ores the bot will Smelt." Category="Smelting" Global="False" Hidden="False" />
  </SubRoutine>
  <CustomAction Code="GreenTeaStacks = (Int16)Settings[&quot;Green Tea Leaf&quot;];&#xD;&#xA;SnowLilyStacks = (Int16)Settings[&quot;Snow Lily&quot;];&#xD;&#xA;RainPoppyStacks = (Int16)Settings[&quot;Rain Poppy&quot;];&#xD;&#xA;SilkweedStacks = (Int16)Settings[&quot;Silkweed&quot;];&#xD;&#xA;DesecratedStacks = (Int16)Settings[&quot;Desecrated Herb&quot;];&#xD;&#xA;FoolStacks = (Int16)Settings[&quot;Fool's Cap&quot;];&#xD;&#xA;GhostIronStacks = (Int16)Settings[&quot;Ghost Iron Ore&quot;];&#xD;&#xA;GoldenLotusStacks = (Int16)Settings[&quot;Golden Lotus ( Singles 1x )&quot;];&#xD;&#xA;KypariteStacks = (Int16)Settings[&quot;Kyparite&quot;];&#xD;&#xA;BlackTrilliumStacks = (Int16)Settings[&quot;Black Trillium Ore&quot;];&#xD;&#xA;WhiteTrilliumStacks = (Int16)Settings[&quot;White Trillium Ore&quot;];&#xD;&#xA;GhostBarStacks = (Int16)Settings[&quot;Ghost Iron Bar&quot;];&#xD;&#xA;TrilliumBarStacks = (Int16)Settings[&quot;Trillium Bar ( Singles 1x )&quot;];" />
  <CustomAction Code="DoTownRun = (bool)Settings[&quot;Do Town Run&quot;];" />
  <CustomAction Code="Smelt = (bool)Settings[&quot;Smelt Ores&quot;];" />
  <CustomAction Code="SmeltPercent = (Int16)Settings[&quot;Percentage % of Ores to Smelt&quot;];" />
  <If Condition="!(DoTownRun || Smelt)" IgnoreCanRun="True">
    <CustomAction Code="OnlyGather = true;" />
  </If>
  <SubRoutine SubRoutineName="TownRun">
    <If Condition="Smelt" IgnoreCanRun="True">
      <CallSubRoutine SubRoutineName="Smelt" />
    </If>
    <SellItemOnAhAction Category="TradeGoods" SubCategoryType="WoWItemTradeGoodsClass" SubCategory="None" UseCategory="False" RunTime="_12_Hours" AmountType="Amount" ItemID="79010" MinBuyout="1g10s0c" MaxBuyout="10g0s0c" StackSize="20" IgnoreStackSizeBelow="1" Amount="SnowLilyStacks" BidPrecent="95" UndercutPrecent="0.1" AutoFindAh="True" PostIfBelowMinBuyout="True" Location="0, 0, 0" />
    <SellItemOnAhAction Category="TradeGoods" SubCategoryType="WoWItemTradeGoodsClass" SubCategory="None" UseCategory="False" RunTime="_12_Hours" AmountType="Amount" ItemID="72234" MinBuyout="1g10s0c" MaxBuyout="10g0s0c" StackSize="20" IgnoreStackSizeBelow="1" Amount="GreenTeaStacks" BidPrecent="95" UndercutPrecent="0.1" AutoFindAh="True" PostIfBelowMinBuyout="True" Location="0, 0, 0" />
    <SellItemOnAhAction Category="TradeGoods" SubCategoryType="WoWItemTradeGoodsClass" SubCategory="None" UseCategory="False" RunTime="_12_Hours" AmountType="Amount" ItemID="72237" MinBuyout="1g10s0c" MaxBuyout="10g0s0c" StackSize="20" IgnoreStackSizeBelow="1" Amount="RainPoppyStacks" BidPrecent="95" UndercutPrecent="0.1" AutoFindAh="True" PostIfBelowMinBuyout="True" Location="0, 0, 0" />
